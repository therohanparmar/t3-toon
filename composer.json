{
    "name": "rrp/t3-toon",
    "description": "TOON for TYPO3 — AI-ready data format for LLM prompts, AI agents, ChatGPT, Gemini, Claude, Mistral, OpenAI, and TYPO3 AI integrations. Convert JSON ⇄ TOON for compact, token-efficient AI context exchange.",
    "type": "typo3-cms-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Rohan Parmar",
            "homepage": "https://github.com/therohanparmar/t3-toon",
            "role": "Developer"
        },
        {
            "name": "Himanshu Ramavat",
            "homepage": "https://github.com/himanshuramavat",
            "role": "Developer"
        }
    ],
    "keywords": [
        "typo3",
        "typo3-package",
        "typo3-ai",
        "typo3-chatgpt",
        "typo3-gemini",
        "typo3-openai",
        "typo3-anthropic",
        "typo3-mistral",
        "ai",
        "ai-integration",
        "ai-tools",
        "ai-prompt",
        "prompt",
        "prompt-engineering",
        "prompt-optimization",
        "prompt-compression",
        "context-optimizer",
        "context-compression",
        "token",
        "token-efficient",
        "token-optimizer",
        "token-saver",
        "llm",
        "llm-tools",
        "openai",
        "chatgpt",
        "claude",
        "anthropic",
        "gemini",
        "mistral",
        "gpt",
        "gpt4",
        "gpt3",
        "ai-developer-tools",
        "json",
        "data",
        "data-formatter",
        "data-compression",
        "data-transformer",
        "compact-json",
        "converter",
        "formatter",
        "parser",
        "serialization",
        "serialization-format",
        "yaml-alternative",
        "object-notation",
        "human-readable-format",
        "php",
        "php8",
        "toon",
        "toon-typo3",
        "typo3-toon",
        "ai-for-typo3",
        "chatgpt-for-typo3",
        "gemini-for-typo3",
        "openai-for-typo3",
        "claude-for-typo3",
        "llm-for-typo3",
        "ai-typo3-package"
    ],
    "homepage": "https://extensions.typo3.org/extension/rrp_t3toon",
    "support": {
        "issues": "https://github.com/therohanparmar/t3-toon/issues",
        "source": "https://github.com/therohanparmar/t3-toon",
        "docs": "https://docs.typo3.org/p/rrp/t3-toon/main/en-us/"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "typo3/testing-framework": "^7 || ^8 || ^9"
    },
    "autoload": {
        "psr-4": {
            "RRP\\T3Toon\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RRP\\T3Toon\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "rrp_t3toon"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "scripts": {
        "test:unit": "../../vendor/bin/phpunit -c phpunit.xml.dist",
        "analyse": "phpstan analyse -c phpstan.neon",
        "doc-watch": "docker run --rm -it --pull always -v $(pwd)/Documentation:/project/Documentation -v $(pwd)/Documentation-GENERATED-temp:/project/Documentation-GENERATED-temp -p 1337:1337 ghcr.io/typo3-documentation/render-guides:latest --config=Documentation --watch"
    },
    "scripts-descriptions": {
        "test:unit": "Run unit tests",
        "analyse": "Run PHPStan static analysis",
        "doc-watch": "Render documentation with watcher"
    }
}
