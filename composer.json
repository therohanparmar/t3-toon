{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "rrp/t3-toon",
    "description": "TOON for TYPO3 — Spec-compliant TOON for TYPO3: token-efficient AI data format with JSON ⇄ TOON conversion for LLMs and AI agents.",
    "type": "typo3-cms-extension",
    "license": "MIT",
    "readme": "README.md",
    "authors": [
        {
            "name": "Rohan Parmar",
            "homepage": "https://github.com/therohanparmar/t3-toon",
            "role": "Developer"
        },
        {
            "name": "Himanshu Ramavat",
            "homepage": "https://github.com/himanshuramavat",
            "role": "Developer"
        }
    ],
    "keywords": [
        "toon",
        "toon-format",
        "token-oriented-object-notation",
        "json",
        "serialization",
        "llm",
        "token-efficient",
        "php",
        "typo3",
        "typo3-cms-extension",
        "encoder",
        "decoder"
    ],
    "homepage": "https://github.com/therohanparmar/t3-toon",
    "support": {
        "issues": "https://github.com/therohanparmar/t3-toon/issues",
        "source": "https://github.com/therohanparmar/t3-toon",
        "docs": "https://docs.typo3.org/p/rrp/t3-toon/4.0/en-us/"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "typo3/testing-framework": "^7 || ^8 || ^9"
    },
    "autoload": {
        "psr-4": {
            "RRP\\T3Toon\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RRP\\T3Toon\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "extension-key": "rrp_t3toon",
            "Package": {
                "providesPackages": []
            },
            "version": "4.0.0"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "scripts": {
        "test:unit": "../../vendor/bin/phpunit -c phpunit.xml.dist",
        "test:conformance": "php Tests/run-conformance.php",
        "analyse": "phpstan analyse -c phpstan.neon",
        "doc-watch": "docker run --rm -it --pull always -v $(pwd)/Documentation:/project/Documentation -v $(pwd)/Documentation-GENERATED-temp:/project/Documentation-GENERATED-temp -p 1337:1337 ghcr.io/typo3-documentation/render-guides:latest --config=Documentation --watch"
    },
    "scripts-descriptions": {
        "test:unit": "Run unit tests",
        "test:conformance": "Run TOON spec v3.3 conformance fixtures (389 encode + decode)",
        "analyse": "Run PHPStan static analysis",
        "doc-watch": "Render documentation with watcher"
    }
}
