        <source>Delete selected (%d)</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">حذف المحدد (%d)</target>
      </trans-unit>
      <trans-unit id="logs.delete.confirm_title">
        <source>Delete log entries?</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">حذف إدخالات السجلات؟</target>
      </trans-unit>
      <trans-unit id="logs.delete.confirm_body_single">
        <source>This will permanently remove the selected log entry. This action cannot be undone.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">سيؤدي هذا إلى إزالة إدخال السجل المحدد بشكل دائم. لا يمكن التراجع عن هذا الإجراء.</target>
      </trans-unit>
      <trans-unit id="logs.delete.confirm_body_bulk">
        <source>This will permanently remove the selected log entries. This action cannot be undone.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">سيؤدي هذا إلى إزالة إدخالات السجل المحددة بشكل دائم. لا يمكن التراجع عن هذا الإجراء.</target>
      </trans-unit>
      <trans-unit id="logs.delete.confirm_button">
        <source>Yes, delete</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">نعم، حذف</target>
      </trans-unit>
      <trans-unit id="logs.delete.cancel">
        <source>Cancel</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">إلغاء</target>
      </trans-unit>
      <trans-unit id="logs.flash.deleted_title">
        <source>Log entries deleted</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">تم حذف إدخالات السجل</target>
      </trans-unit>
      <trans-unit id="logs.flash.deleted_body">
        <source>%d log entry/entries were removed.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">تم إزالة إدخال/إدخال السجل %d.</target>
      </trans-unit>
      <trans-unit id="logs.flash.nothing_title">
        <source>Nothing deleted</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">لا شيء محذوف</target>
      </trans-unit>
      <trans-unit id="logs.flash.nothing_body">
        <source>No matching log entries were found.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">لم يتم العثور على إدخالات مطابقة للسجل.</target>
