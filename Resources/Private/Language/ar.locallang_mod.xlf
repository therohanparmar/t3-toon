    <header/>
    <body>
      <trans-unit id="mlang_tabs_tab">
        <source>TOON Playground</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">توون بلاي</target>
      </trans-unit>
      <trans-unit id="playground.title">
        <source>TOON Playground</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">توون بلاي</target>
      </trans-unit>
      <trans-unit id="playground.input_label">
        <source>Input (JSON for encode, TOON for decode)</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الإدخال (JSON للترميز، TOON للترميز)</target>
      </trans-unit>
      <trans-unit id="playground.output_label">
        <source>Output</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الناتج</target>
      </trans-unit>
      <trans-unit id="playground.encode">
        <source>Encode to TOON</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الترميز إلى TOON</target>
      </trans-unit>
      <trans-unit id="playground.decode">
        <source>Decode from TOON</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">فك الترميز من TOON</target>
      </trans-unit>
      <trans-unit id="playground.encode_compact">
        <source>Encode (compact)</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">ترميز (ميثاق)</target>
      </trans-unit>
      <trans-unit id="playground.tokens">
        <source>Estimated tokens: %d</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">العملات المميزة المقدرة: %d</target>
      </trans-unit>
      <trans-unit id="playground.footer_made_with">
        <source>Made with 🧡 for the TYPO3 Developer by Rohan and Himanshu</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">صُنع مع 🧡 لمطوري TYPO3 من قبل روهان وهيمانشو</target>
      </trans-unit>
      <trans-unit id="playground.subtitle">
        <source>Encode JSON to TOON or decode strings instantly.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">ترميز JSON إلى TOON أو فك شفرة السلاسل على الفور.</target>
      </trans-unit>
      <trans-unit id="playground.clear_all">
        <source>Clear All</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">مسح الكل</target>
      </trans-unit>
      <trans-unit id="playground.view_logs">
        <source>View Logs</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">عرض السجلات</target>
      </trans-unit>
      <trans-unit id="playground.badge_input">
        <source>Input</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">Input</target>
      </trans-unit>
      <trans-unit id="playground.or">
        <source>OR</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">أو</target>
      </trans-unit>
      <trans-unit id="playground.estimated_tokens_label">
        <source>Estimated tokens</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الرموز المميزة التقديرية</target>
      </trans-unit>
      <trans-unit id="playground.copy">
        <source>Copy</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">نسخ</target>
      </trans-unit>
      <trans-unit id="playground.copied_to_clipboard">
        <source>Copied to clipboard!</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">تم النسخ إلى الحافظة!</target>
      </trans-unit>
      <trans-unit id="playground.github">
        <source>GitHub</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">GitHub</target>
      </trans-unit>
      <trans-unit id="playground.documentation">
        <source>Documentation</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الوثائق</target>
      </trans-unit>
      <trans-unit id="playground.clear_confirm">
        <source>Clear both input and output?</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">مسح كل من الإدخال والمخرج؟</target>
      </trans-unit>
      <trans-unit id="playground.clear_confirm_title">
        <source>Clear All</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">مسح الكل</target>
      </trans-unit>
      <trans-unit id="playground.clear_confirm_body">
        <source>This will clear both the input and output fields. This action cannot be undone.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">سيؤدي هذا إلى مسح حقول الإدخال والمخرج. لا يمكن التراجع عن هذا الإجراء.</target>
      </trans-unit>
      <trans-unit id="playground.cancel">
        <source>Cancel</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">إلغاء</target>
      </trans-unit>
      <trans-unit id="playground.confirm_clear">
        <source>Yes, Clear All</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">نعم، مسح الكل</target>
      </trans-unit>
      <trans-unit id="playground.placeholder">
        <source>{"name": "TOON", "items": [1, 2, 3]}</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">{"الاسم": "TOON"، "البنود": [1, 2, 3]}</target>
      </trans-unit>
      <trans-unit id="playground.error_invalid_json">
        <source>Invalid JSON input for encode.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">إدخال JSON غير صالح للترميز.</target>
      </trans-unit>
      <trans-unit id="optimization_note.title">
        <source>Why is optimization sometimes negative?</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">لماذا يكون التحسين سلبيا في بعض الأحيان؟</target>
      </trans-unit>
      <trans-unit id="optimization_note.body">
        <source>The optimization % compares the TOON output against minified JSON (not the indented text you paste). TOON saves the most on arrays of uniform records, which collapse into a single table header plus one compact line per row — the more rows, the bigger the saving. Deeply nested data with few or no repeating arrays has nothing to tabularize and can come out slightly larger, showing a negative percentage. This is expected, not an error.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">تحسين النسبة المئوية يقارن ناتج TOON مقابل JSON المصغر (ليس النص المعوز الذي تلصقه). يوفر TOON أكثر ما يحفظ في مصفوفات سجلات الزي الرسمي، الذي ينهار في رأس جدول واحد بالإضافة إلى خط مدمج واحد في الصف الواحد - كلما زاد عدد الصفوف كلما كان المدخرات أكبر. البيانات المتداخلة بعمق مع عدد قليل من المصفوفات المتكررة أو لا توجد لديها أي مصفوفات يمكن جدولتها ويمكن أن تخرج أكبر قليلا، تظهر نسبة سالبة. وهذا أمر متوقع، وليس خطأ.</target>
      </trans-unit>
      <trans-unit id="optimization_note.close">
        <source>Dismiss note</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">تجاهل الملاحظة</target>
      </trans-unit>
      <trans-unit id="logs.mlang_tabs_tab">
        <source>TOON Logs</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">سجلات التون</target>
      </trans-unit>
      <trans-unit id="logs.title">
        <source>TOON Usage Logs</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">سجلات الاستخدام</target>
      </trans-unit>
      <trans-unit id="logs.subtitle">
        <source>Every successful encode/convert call recorded with input size, output size, and compression ratio.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">كل مكالمة شفرية/تحويل ناجحة مسجلة بحجم الإدخال، حجم المخرج، نسبة الضغط.</target>
      </trans-unit>
      <trans-unit id="logs.back_to_playground">
        <source>Back to Playground</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">العودة إلى صفحة التشغيل</target>
      </trans-unit>
      <trans-unit id="logs.filter.legend">
        <source>Filters</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">فلاتر</target>
      </trans-unit>
      <trans-unit id="logs.filter.date_from">
        <source>From</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">من</target>
      </trans-unit>
      <trans-unit id="logs.filter.date_to">
        <source>To</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">إلى</target>
      </trans-unit>
      <trans-unit id="logs.filter.enabled">
        <source>Optimization status</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">حالة التحسين</target>
      </trans-unit>
      <trans-unit id="logs.filter.enabled.all">
        <source>All</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الكل</target>
      </trans-unit>
      <trans-unit id="logs.filter.enabled.on">
        <source>Enabled</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">تمكين</target>
      </trans-unit>
      <trans-unit id="logs.filter.enabled.off">
        <source>Disabled</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">معطل</target>
      </trans-unit>
      <trans-unit id="logs.filter.min_pct">
        <source>Min optimization %</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الحد الأدنى لتحسين %</target>
      </trans-unit>
      <trans-unit id="logs.filter.per_page">
        <source>Per page</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">لكل صفحة</target>
      </trans-unit>
      <trans-unit id="logs.filter.apply">
        <source>Apply</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">تطبيق</target>
      </trans-unit>
      <trans-unit id="logs.filter.reset">
        <source>Reset</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">Reset</target>
      </trans-unit>
      <trans-unit id="logs.column.uid">
        <source>UID</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">UID</target>
      </trans-unit>
      <trans-unit id="logs.column.date">
        <source>Date &amp; Time</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">التاريخ &amp; الوقت</target>
      </trans-unit>
      <trans-unit id="logs.column.input_size">
        <source>Input size</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">Input size</target>
      </trans-unit>
      <trans-unit id="logs.column.output_size">
        <source>Output size</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">حجم الناتج</target>
      </trans-unit>
      <trans-unit id="logs.column.optimization">
        <source>Optimization</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">تحسين</target>
      </trans-unit>
      <trans-unit id="logs.column.enabled">
