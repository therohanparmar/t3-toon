      <trans-unit id="logs.pagination.next">
        <source>Next</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">التالي</target>
      </trans-unit>
      <trans-unit id="logs.pagination.last">
        <source>Last</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">اخر</target>
      </trans-unit>
      <trans-unit id="logs.pagination.summary">
        <source>Page %1$d of %2$d (%3$d total)</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الصفحة %1$d من %2$d ( المجموع%3$d)</target>
      </trans-unit>
    </body>
