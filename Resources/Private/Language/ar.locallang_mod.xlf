      <trans-unit id="logs.pagination.first">
        <source>First</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الأول</target>
      </trans-unit>
      <trans-unit id="logs.pagination.previous">
        <source>Previous</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">السابق</target>
