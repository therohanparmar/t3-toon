        <source>Actions</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">الإجراءات</target>
      </trans-unit>
      <trans-unit id="logs.column.select">
        <source>Select</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">حدد</target>
      </trans-unit>
      <trans-unit id="logs.empty.title">
        <source>No log entries yet</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">لا توجد إدخالات سجل بعد</target>
      </trans-unit>
      <trans-unit id="logs.empty.body">
        <source>Run an encode operation from the TOON Playground to record your first log entry.</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">قم بتشغيل عملية ترميز من TOON Playground لتسجيل أول إدخال سجل لديك.</target>
      </trans-unit>
      <trans-unit id="logs.empty.cta">
        <source>Open TOON Playground</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">فتح ملعب TON</target>
      </trans-unit>
      <trans-unit id="logs.delete.single">
        <source>Delete</source>
        <target state="needs-review-translation" state-qualifier="leveraged-mt">حذف</target>
      </trans-unit>
